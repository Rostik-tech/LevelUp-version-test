{
  "info": {
    "_postman_id": "4176b94d-96be-443c-8350-a28788d4cbed",
    "name": "Auth Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "51077768"
  },
  "item": [
    {
      "name": "register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const random = Math.floor(Math.random() * 100000);\r",
              "\r",
              "pm.environment.set(\"email\", `test${random}@gmail.com`);\r",
              "pm.environment.set(\"username\", `user${random}`);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "// Проверка структуры\r",
              "pm.test(\"Response has user object\", function () {\r",
              "    pm.expect(jsonData).to.have.property(\"user\");\r",
              "});\r",
              "\r",
              "// Проверка id\r",
              "pm.test(\"User has id\", function () {\r",
              "    pm.expect(jsonData.user).to.have.property(\"id\");\r",
              "});\r",
              "\r",
              "// Проверка email\r",
              "pm.test(\"User has email\", function () {\r",
              "    pm.expect(jsonData.user).to.have.property(\"email\");\r",
              "});\r",
              "\r",
              "// Проверка username\r",
              "pm.test(\"User has username\", function () {\r",
              "    pm.expect(jsonData.user).to.have.property(\"username\");\r",
              "});\r",
              "\r",
              "// Сохраняем для login\r",
              "pm.environment.set(\"email\", jsonData.user.email);\r",
              "pm.environment.set(\"password\", \"12345678\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"username\": \"{{username}}\",\r\n  \"email\": \"{{email}}\",\r\n  \"password\": \"12345678\",\r\n  \"fullName\": \"Test User\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://www.levelup-gaming.store/api/auth/register",
          "protocol": "https",
          "host": [
            "www",
            "levelup-gaming",
            "store"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login status is 500\", function () {\r",
              "    pm.response.to.have.status(500);\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Response has token\", function () {\r",
              "    pm.expect(jsonData).to.have.property(\"token\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"{{email}}\",\r\n  \"password\": \"{{password}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://www.levelup-gaming.store/api/auth/login",
          "protocol": "https",
          "host": [
            "www",
            "levelup-gaming",
            "store"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    }
  ]
}
